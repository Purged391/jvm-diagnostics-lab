# Java build outputs
*.class
.build/
bin/
out/
target/
build/

# Raw diagnostic artifacts: keep local, publish reviewed excerpts in docs instead.
*.hprof
*.hprof.*
*.jfr
*.log
*.log.*
hs_err_pid*
replay_pid*
/diagnostics/
/*-samples.txt
/*-events.txt
/*-threads.txt
/thread-dump*.txt
/thread-lock.txt
/histogram.txt

# Archives and operating-system files
*.zip
*.tar.gz
*.rar
.DS_Store
Thumbs.db

# Publish portable launch configurations, not machine-specific editor settings.
/.vscode/*
!/.vscode/launch.json
!/.vscode/extensions.json
